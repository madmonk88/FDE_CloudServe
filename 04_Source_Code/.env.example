# Copy to .env and fill in. .env is gitignored and must never be committed.
# No credential, key or token may appear anywhere in committed source.

# --- Model provider -------------------------------------------------------
# The brief names OpenRouter and Groq, and permits a local model instead.
# Set ONE key. Either variable name works.
#
# GROQ IS THE DEFAULT, for two reasons discovered the hard way:
#
#   1. OpenRouter retired the free Llama 3.3 70B. Calling the ":free" slug now
#      returns 404 telling you to use the paid one. Its remaining free models
#      are unfamiliar and could be withdrawn the same way.
#   2. Latency is an assessed target (95th percentile under 3 seconds) and
#      each ticket makes two or three sequential model calls. Groq serves
#      Llama 3.3 70B at roughly 280 tokens/second and Llama 3.1 8B at about
#      560. That is the difference between missing the target badly and
#      missing it narrowly, or meeting it.
#
# Get a free key at https://console.groq.com — no card required.
GROQ_API_KEY=

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Roughly twice as fast again, and the size the pack's own template suggests.
# Worth trying if the 70B still misses the latency target: on a 29-article
# corpus with grounded retrieval, model size matters less than retrieval
# quality, and that trade is worth stating in the report.
# LLM_MODEL=llama-3.1-8b-instant

# For OpenRouter instead. Check https://openrouter.ai/models?q=free for what
# is actually free on the day you run it — the list changes.
# OPENROUTER_API_KEY=
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<a model that carries the :free suffix today>

# Temperature is zero so that the same ticket produces the same routing
# decision (acceptance criterion A5). Changing it breaks that guarantee.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=900
LLM_TIMEOUT=45
LLM_MAX_RETRIES=4

# Self-imposed ceiling, kept under the free tier's limit so a long run paces
# itself rather than being throttled part way through.
LLM_RPM=30

# Consecutive failures before the circuit opens and the system runs on its
# deterministic fallback path.
LLM_CIRCUIT_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN=60

# The longest we will ever honour a provider's Retry-After. Beyond this the
# rate limit is quota exhaustion rather than a brief throttle, and sleeping
# through it stalls the run for hours. Past the cap the system treats the
# provider as unavailable and degrades, which is what A11 asks for. Cached
# work is kept, so --resume picks up cheaply once the quota resets.
LLM_MAX_RETRY_AFTER=30

# Cache model responses to disk. Keep this on: it protects the free-tier
# allowance and makes a run reproducible.
LLM_CACHE=true

# --- Retrieval ------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
# The floor below which retrieval returns NOTHING. Tune it with
#   python -m scripts.tune_retrieval_floor
# Do not set it by eye: the score scale differs depending on whether dense
# retrieval is available, and a value chosen under one scale is meaningless
# under the other.
RETRIEVAL_MIN_SCORE=0.18
RETRIEVAL_CHUNK_CHARS=900
RETRIEVAL_CHUNK_OVERLAP=150
RETRIEVAL_DENSE_WEIGHT=0.65
RETRIEVAL_LEXICAL_SATURATION=16.0

# --- Routing thresholds ---------------------------------------------------
# Most of the routing policy was recovered from the labels rather than chosen
# (python -m scripts.derive_policy). Only these are tuned.

# Probability that the documentation can answer the ticket, below which it
# escalates and is recorded as a documentation gap. The single most
# consequential number in the system.
#   python -m scripts.tune_answerability
ROUTE_ANSWERABLE_THRESHOLD=0.58

# Classification confidence below which the policy's rules cannot be applied
# safely, because they all key on intent.
ROUTE_MIN_CLASS_CONF=0.55

# Proportion of the drafted reply that must trace back to its sources.
ROUTE_MIN_GROUNDING=0.60

# --- Guardrails -----------------------------------------------------------
# These default to blocking. They exist as switches so the report can show
# what changes when a control is relaxed, not so they can be turned off for
# a demonstration.
GUARD_BLOCK_PII=true
GUARD_BLOCK_UNSUPPORTED=true
GUARD_BLOCK_COMMITMENT=true
GUARD_SENTENCE_SUPPORT=0.38
GUARD_MIN_SUPPORTED_RATIO=0.70

# --- Paths ----------------------------------------------------------------
DATA_DIR=data
STORAGE_DIR=storage
DOCUMENTATION_FILE=data/documentation.json

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# The kill switch. Setting this to false routes every ticket to the human
# queue while keeping classification, retrieval and logging running.
AUTOMATION_ENABLED=true
