# Copy to .env and fill in. .env is gitignored and must never be committed.
# No credential, key or token may appear anywhere in committed source.

# --- Model provider -------------------------------------------------------
# OpenRouter (https://openrouter.ai) and Groq both expose an OpenAI-compatible
# API and both have a free tier sufficient for this project. Set the key for
# whichever you use; the base URL and model name select between them.
OPENROUTER_API_KEY=

LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# For Groq instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Temperature is zero so that the same ticket produces the same routing
# decision (acceptance criterion A5). Changing it breaks that guarantee.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=900
LLM_TIMEOUT=45
LLM_MAX_RETRIES=4

# Self-imposed ceiling, kept under the free tier's limit so that a long run
# paces itself rather than being throttled part way through.
LLM_RPM=20

# Consecutive failures before the circuit opens and the system runs on its
# deterministic fallback path.
LLM_CIRCUIT_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN=60

# Cache model responses to disk. Keep this on: it protects the free-tier
# allowance and makes a run reproducible.
LLM_CACHE=true

# --- Retrieval ------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_CHUNK_CHARS=900
RETRIEVAL_CHUNK_OVERLAP=150
RETRIEVAL_DENSE_WEIGHT=0.65

# --- Routing thresholds ---------------------------------------------------
# Determined with scripts/tune_thresholds.py against the development set.
# See the PRD assumptions section for the cost ratio these rest on.
ROUTE_MIN_CLASS_CONF=0.70
ROUTE_MIN_RETRIEVAL=0.42
ROUTE_MIN_GROUNDING=0.60

# --- Guardrails -----------------------------------------------------------
# These default to blocking. They exist as switches so the report can show
# what changes when a control is relaxed, not so they can be turned off for
# a demonstration.
GUARD_BLOCK_PII=true
GUARD_BLOCK_UNSUPPORTED=true
GUARD_BLOCK_COMMITMENT=true
GUARD_SENTENCE_SUPPORT=0.38
GUARD_MIN_SUPPORTED_RATIO=0.70

# --- Paths ----------------------------------------------------------------
DATA_DIR=data
STORAGE_DIR=storage
DOCUMENTATION_FILE=data/documentation.json

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# The kill switch. Setting this to false routes every ticket to the human
# queue while keeping classification, retrieval and logging running.
AUTOMATION_ENABLED=true
